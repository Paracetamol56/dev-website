						"schema": {
							"type": "object",
							"additionalProperties": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"/icons/search": {
			"get": {
				"description": "Search lucide.dev and simpleicons.org icons by text (every word must match the name, title or a tag), source and tag. Results are ranked by relevance.",
				"produces": ["application/json"],
				"tags": ["icons"],
				"summary": "Search icons",
				"parameters": [
					{
						"type": "string",
						"description": "Text to search for",
						"name": "q",
						"in": "query"
					},
					{
						"type": "array",
						"items": {
							"enum": ["lucide", "simpleicons"],
							"type": "string"
						},
						"collectionFormat": "multi",
						"description": "Only return icons from these sources (repeat the parameter for several)",
						"name": "source",
						"in": "query"
					},
					{
						"type": "string",
						"description": "Only return icons having this tag (case-insensitive)",
						"name": "tag",
						"in": "query"
					},
					{
						"maximum": 500,
						"minimum": 1,
						"type": "integer",
						"default": 50,
						"description": "Maximum number of results",
						"name": "limit",
						"in": "query"
					},
					{
						"minimum": 0,
						"type": "integer",
						"default": 0,
						"description": "Number of results to skip",
						"name": "offset",
						"in": "query"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"schema": {
							"$ref": "#/definitions/models.IconSearchResult"
						}
					},
					"400": {
						"description": "Bad Request",
						"schema": {
							"type": "object",
							"additionalProperties": {
								"type": "string"
							}
						}
					},
					"500": {
						"description": "Internal Server Error",
						"schema": {
							"type": "object",
							"additionalProperties": {
								"type": "string"
							}
						}
					}
				}
			}
		},
